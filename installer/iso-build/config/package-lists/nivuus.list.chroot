# Packages baked into the live installer environment.

# Hotspot + captive portal
hostapd
dnsmasq
iw
wireless-regdb
wpasupplicant
qrencode
nftables
iproute2

# Web portal runtime (venv built by hook adds fastapi/uvicorn/pydantic/jinja2)
python3
python3-venv
python3-pip
ca-certificates

# Wizard choices are read from Debian's own lists (common/regional.py):
# locales -> /usr/share/i18n/SUPPORTED, xkb-data -> XKB layouts. The time
# zone comes from the browser and is checked against the target.
locales
xkb-data

# Install engine: partitioning, debootstrap, filesystems, payload copy
debootstrap
parted
gdisk
dosfstools
e2fsprogs
lvm2
rsync
udev

# Firmware so WiFi/NICs work in the live env on real hardware
firmware-linux
firmware-iwlwifi
firmware-realtek
firmware-atheros

# Convenience for on-console diagnostics
pciutils
usbutils
less
nano
