#!/bin/sh
# Build a self-contained Python venv for the portal inside the live chroot.
# Debian bookworm ships pydantic 1.x; the portal needs pydantic v2, so we pip
# install from requirements.txt (binary wheels — no compiler needed).
set -e

VENV=/opt/nivuus-installer/venv
REQ=/opt/nivuus-installer/webapp/requirements.txt

if [ ! -f "$REQ" ]; then
    echo "E: $REQ missing — was the installer payload synced into includes.chroot?" >&2
    exit 1
fi

python3 -m venv "$VENV"
"$VENV/bin/pip" install --no-cache-dir --upgrade pip
"$VENV/bin/pip" install --no-cache-dir -r "$REQ"

# Sanity check the critical imports so a broken venv fails the build, not boot.
"$VENV/bin/python3" - <<'PY'
import fastapi, uvicorn, pydantic, jinja2, yaml
assert pydantic.VERSION.startswith("2"), f"need pydantic v2, got {pydantic.VERSION}"
print("venv OK:", fastapi.__version__, pydantic.VERSION, "pyyaml", yaml.__version__)
PY
