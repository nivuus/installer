#!/usr/bin/env python3
"""Hold a system-wide PM QoS CPU DMA latency constraint.

Opening /dev/cpu_dma_latency and writing a little-endian int32 (microseconds)
imposes a system-wide upper bound on CPU wake-up latency: a C-state is usable
only if its exit latency is below the bound. The constraint holds for exactly
as long as the file descriptor stays open, so this process writes the value and
then blocks forever. Its lifetime *is* the policy — on SIGTERM the fd closes and
the constraint lifts, with no state to reset and nothing to clean up.

Used by nivuus-cpu-latency.service, which optimize-cpu-thermal.sh starts in
gaming mode (to recreate the C6 ceiling the VFIO guest needs) and stops in idle
mode (to let the host reach deep package C-states). See
docs/superpowers/specs/2026-07-22-vm-aware-cpu-power-mode-design.md.

Usage: nivuus-cpu-latency [microseconds]   (default 250)
"""
import os
import signal
import struct
import sys

latency_us = int(sys.argv[1]) if len(sys.argv) > 1 else 250

fd = os.open("/dev/cpu_dma_latency", os.O_WRONLY)
os.write(fd, struct.pack("i", latency_us))
# Block until the service is stopped; closing the fd releases the constraint.
signal.pause()
