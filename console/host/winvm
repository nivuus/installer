#!/bin/bash
# Run one command in the Windows guest: `winvm <cmd>` (cmd.exe) or
# `winvm --ps <cmd>` (PowerShell).
#
# A thin wrapper around the package's own guest/winrm_exec.py, run in place -
# the same client guest-ready-watch.py uses. The previous version drove
# /usr/local/bin/winrm, which speaks Basic only: the LTSC guest has
# "Basic = false" and "AllowUnencrypted = false", so every call ended in a 401
# that never says it is about the authentication mode. pywinrm negotiates
# NTLM and gets through. That client was also placed by nobody, and its
# password lived in a config file created by nobody.
#
# The password is the file console/guest_steps.py's `secrets` step writes from
# the wizard's admin_password answer - never argv, so it cannot leak into the
# process table - and the same file guest-ready-watch.py reads.
#
# vm-idle-shutdown.sh depends on this script to measure the guest's CPU and to
# hibernate it: if it breaks, power saving dies and the VM stays on. So it
# fails loudly, with the missing piece named, rather than silently.
set -euo pipefail

PACKAGE_DIR="${NIVUUS_CONSOLE_DIR:-/opt/nivuus-packages/console}"
EXEC="${NIVUUS_WINRM_EXEC:-$PACKAGE_DIR/guest/winrm_exec.py}"
PASS_FILE="${GUEST_PASS_FILE:-/var/lib/nivuus/guest/secrets/windows-admin.pass}"

if [ $# -eq 0 ]; then
    echo "usage: winvm <command>            # cmd.exe" >&2
    echo "       winvm --ps <command>       # powershell" >&2
    exit 2
fi
[ -r "$PASS_FILE" ] || { echo "winvm: guest password unreadable: $PASS_FILE" >&2; exit 1; }
[ -r "$EXEC" ] || { echo "winvm: winrm_exec.py not found: $EXEC" >&2; exit 1; }

MODE="cmd"
if [ "$1" = "--ps" ]; then MODE="ps"; shift; fi

# The names winrm_exec.py actually reads. GUEST_IP and GUEST_USER keep its
# own defaults (192.168.3.2, Administrator) unless the caller sets them.
export GUEST_PASS_FILE="$PASS_FILE"
exec python3 "$EXEC" "$MODE" "$@"
