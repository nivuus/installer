#!/bin/bash
# WinVM - Execute commands on Windows VM via WinRM
# Usage: winvm "command to execute"

set -euo pipefail

# Configuration file
CONFIG_FILE="${HOME}/.config/nivuus/winvm.conf"

# Default configuration
WINRM_CLI="/usr/local/bin/winrm"
VM_HOSTNAME="${VM_HOSTNAME:-192.168.3.2}"
VM_USERNAME="${VM_USERNAME:-Administrateur}"
VM_PASSWORD="${VM_PASSWORD:-}"

# Load configuration if exists
if [[ -f "$CONFIG_FILE" ]]; then
    # shellcheck source=/dev/null
    source "$CONFIG_FILE"
fi

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Check if winrm-cli exists
if [[ ! -f "$WINRM_CLI" ]]; then
    echo -e "${RED}Error: WinRM CLI not found at $WINRM_CLI${NC}" >&2
    echo -e "${YELLOW}Install with:${NC} cd /home/mallanic/Projects/Nivuus && sudo ./scripts/install-winrm-cli.sh" >&2
    exit 1
fi

# Check if password is configured
if [[ -z "$VM_PASSWORD" ]]; then
    echo -e "${RED}Error: VM password not configured${NC}" >&2
    echo -e "${YELLOW}Create config file:${NC} $CONFIG_FILE" >&2
    echo ""
    echo "Example configuration:"
    echo "  VM_HOSTNAME=\"192.168.3.2\""
    echo "  VM_USERNAME=\"Administrateur\""
    echo "  VM_PASSWORD=\"your-password-here\""
    echo ""
    echo "Or set environment variables:"
    echo "  export VM_PASSWORD=\"your-password-here\""
    exit 1
fi

# Check if command is provided
if [[ $# -eq 0 ]]; then
    echo -e "${YELLOW}Usage:${NC} winvm \"command\""
    echo ""
    echo "Examples:"
    echo "  winvm \"hostname\""
    echo "  winvm \"ipconfig\""
    echo "  winvm \"nvidia-smi\""
    echo "  winvm \"powershell -Command 'Get-Process | Select-Object -First 10'\""
    echo "  winvm \"wmic path win32_VideoController get name,status\""
    echo ""
    echo "Configuration:"
    echo "  Config file: $CONFIG_FILE"
    echo "  VM Host: $VM_HOSTNAME"
    echo "  Username: $VM_USERNAME"
    echo "  Password: $(if [[ -n "$VM_PASSWORD" ]]; then echo "configured ✓"; else echo "not set ✗"; fi)"
    exit 1
fi

# Get the command from all arguments
COMMAND="$*"

# Execute the command via WinRM
"$WINRM_CLI" \
    -hostname "$VM_HOSTNAME" \
    -username "$VM_USERNAME" \
    -password "$VM_PASSWORD" \
    "$COMMAND"

# Capture exit code
EXIT_CODE=$?

# Exit with the same code as the remote command
exit $EXIT_CODE
