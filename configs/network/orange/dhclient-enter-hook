# Sourced by dhclient-script, before its own work and before the exit hooks.
#
# Nothing Orange says about name resolution or time may reach this host:
# /etc/resolv.conf is static and feeds the three LAN dnsmasq instances, and the
# packaged exit hooks `resolved` and `timesyncd` would hand Orange resolvers
# and NTP servers to systemd (nsswitch asks resolved before resolv.conf), and
# turn LLMNR on for the WAN link. Dropping the variables here disarms all three
# whatever the order the hooks are sourced in.
if [ "$interface" = "${NIVUUS_WAN_IF:-enp5s0.832}" ]; then
    unset new_domain_name_servers new_domain_name new_domain_search
    unset new_dhcp6_name_servers new_dhcp6_domain_search new_ntp_servers
    make_resolv_conf() { :; }
fi
