[Unit]
Description=Nivuus PCIe WiFi link check (sample AER counters)
Documentation=file:/opt/nivuus/scripts/pcie-wifi-link-guard.sh

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/nivuus-pcie-wifi-link-guard.sh check
# Alerts go to stderr, stored at priority 6 (info). journald fsyncs immediately
# only CRIT and above; this message waits SyncIntervalSec, kept at 5 s by
# journald.conf.d/50-nivuus-forensics.conf so a freeze loses at most that much.
StandardError=journal
Nice=10
TimeoutStartSec=60
